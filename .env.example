# Copy to .env and adjust. Phases 0-1 need no real credentials — these are local-only
# sandbox values. Never put a production secret in this file; it is tracked in git.

# --- Postgres -------------------------------------------------------------
# Host port is non-default on purpose: 5432 usually collides with a locally
# installed Postgres, and that collision looks like a broken stack.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=engineer
POSTGRES_PASSWORD=localdev
POSTGRES_VECTOR_DB=gov_vectors
POSTGRES_CATALOG_DB=iceberg_catalog
POSTGRES_AIRFLOW_DB=airflow

# Sized for HNSW index builds. An index build that exceeds maintenance_work_mem falls
# back to a slow on-disk build; raise this further (per session is fine — it is a
# settable GUC) before a large backfill. Budget against total Docker memory: Spark's
# driver takes 2g and MinIO wants headroom too.
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_PARALLEL_MAINTENANCE_WORKERS=3

# --- MinIO (local S3) -----------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=warehouse
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Iceberg REST catalog -------------------------------------------------
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_REST_PORT=8181

# --- Trino ----------------------------------------------------------------
# 8090 rather than Trino's default 8080, which Airflow wants in Phase 7.
TRINO_PORT=8090
# Where Python clients reach Trino. Keep the port in sync with TRINO_PORT above.
TRINO_URL=http://localhost:8090
# Trino requires a username even with authentication disabled — it is an identity label
# for query attribution, not a credential. Any value works; the password stays empty.
TRINO_USER=crypto-gov
ICEBERG_CATALOG_NAME=gov
ICEBERG_WAREHOUSE=s3://warehouse/

# --- AWS-compatible creds used by Spark/Iceberg S3FileIO ------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# --- Embeddings (Phase 4) -------------------------------------------------
# text-embedding-3-large returns 3072 dimensions by default, which cannot go in
# VECTOR(1536) and cannot be HNSW-indexed at all — pgvector caps indexing at 2000.
# The `dimensions` parameter is what keeps it at 1536; see docs/api-keys.md.
# Verify with `make check-openai` after adding the key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Phase 5: the agent -------------------------------------------------------------
# Two models because the phases have different economics. Routing is one short sentence in
# and small JSON out, on every query; synthesis takes the whole retrieved context. Splitting
# them keeps the per-query cost dominated by the answer rather than the dispatch.
ROUTER_MODEL=gpt-4o-mini
SYNTHESIS_MODEL=gpt-4o-mini

# --- Phase 7: Airflow -------------------------------------------------------------
# Local-dev-only credentials for the Airflow web UI. Change before this stack is ever
# reachable by anyone besides you.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Signs session cookies. A placeholder is fine locally; a real deployment needs a random
# value out of Secrets Manager (see docs/phase-7-plan.md's AWS section), never this one.
AIRFLOW_SECRET_KEY=local-dev-only-not-a-real-secret
# 8080 is Airflow's own default and also one of the most commonly already-occupied local
# ports; mapped externally here to avoid the collision, same reasoning as Postgres's port.
AIRFLOW_WEB_PORT=8082
# Which container the DAGs' Spark step `docker exec`s into. Deterministic from this file's
# `name: crypto-gov` project prefix (docker-compose.yml) unless the dev stack is started
# under a different Compose project name — override only in that case.
SPARK_CONTAINER_NAME=crypto-gov-spark-1
