# Copy to .env and adjust. Phases 0-1 need no real credentials — these are local-only
# sandbox values. Never put a production secret in this file; it is tracked in git.

# --- Postgres -------------------------------------------------------------
# Host port is non-default on purpose: 5432 usually collides with a locally
# installed Postgres, and that collision looks like a broken stack.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=engineer
POSTGRES_PASSWORD=localdev
POSTGRES_VECTOR_DB=gov_vectors
POSTGRES_CATALOG_DB=iceberg_catalog
POSTGRES_AIRFLOW_DB=airflow

# --- MinIO (local S3) -----------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=warehouse
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Iceberg REST catalog -------------------------------------------------
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_REST_PORT=8181
ICEBERG_CATALOG_NAME=gov
ICEBERG_WAREHOUSE=s3://warehouse/

# --- AWS-compatible creds used by Spark/Iceberg S3FileIO ------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
