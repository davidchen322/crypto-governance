{"actions_summary": [{"can_act": false, "count": 0, "hidden": false, "id": 4}, {"can_act": false, "count": 0, "hidden": false, "id": 8}, {"can_act": false, "count": 0, "hidden": false, "id": 10}, {"can_act": false, "count": 0, "hidden": false, "id": 7}], "archetype": "regular", "archived": false, "bookmarked": false, "bookmarks": [], "can_create_shared_issue": false, "can_vote": false, "category_id": 9, "chunk_size": 20, "closed": false, "created_at": "2026-09-01T10:12:44.799Z", "current_post_number": 1, "deleted_at": null, "deleted_by": null, "details": {"can_edit": false, "created_by": {"avatar_template": "/user_avatar/governance.aave.com/aavelabs/{size}/6388_2.png", "id": 5301, "username": "AaveLabs"}, "last_poster": {"avatar_template": "/user_avatar/governance.aave.com/aavelabs/{size}/6388_2.png", "id": 5301, "username": "AaveLabs"}, "notification_level": 1, "participants": [{"admin": true, "avatar_template": "/user_avatar/governance.aave.com/aavelabs/{size}/6388_2.png", "flair_bg_color": "", "flair_color": "", "flair_group_id": 46, "flair_name": "Aave-Labs-SP", "flair_url": "https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/4/443942b48a86edf3ae83c4bad36dac3eb65b182b.png", "id": 5301, "moderator": true, "post_count": 1, "primary_group_name": "Aave-Labs-SP", "trust_level": 4, "username": "AaveLabs"}]}, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "draft": null, "draft_key": "topic_25576", "draft_sequence": null, "fancy_title": "[Direct to AIP] Onboard USDe to Aave V4 Core Instance on Avalanche", "featured_link": null, "has_accepted_answer": false, "has_cached_summary": false, "has_livestream": null, "has_summary": false, "highest_post_number": 1, "id": 25576, "image_url": null, "last_posted_at": "2026-09-01T10:12:44.876Z", "like_count": 0, "message_bus_last_id": 14, "participant_count": 1, "pinned": false, "pinned_at": null, "pinned_globally": false, "pinned_until": null, "post_stream": {"posts": [{"accepted_answer": false, "actions_summary": [], "admin": true, "avatar_template": "/user_avatar/governance.aave.com/aavelabs/{size}/6388_2.png", "badges_granted": [], "bookmarked": false, "calendar_details": [], "can_accept_answer": false, "can_delete": false, "can_edit": false, "can_recover": false, "can_see_hidden_post": false, "can_unaccept_answer": false, "can_view_edit_history": false, "can_vote": false, "can_wiki": false, "cooked": "<p>Title: [Direct to AIP] Onboard USDe to Aave V4 Core Instance on Avalanche<br>\nAuthor: <a class=\"mention\" href=\"/u/aavelabs\">@AaveLabs</a><br>\nDate: 2026-09-01</p>\n<hr>\n<h2><a name=\"p-65296-summary-1\" class=\"anchor\" href=\"#p-65296-summary-1\" aria-label=\"Heading link\"></a>Summary</h2>\n<p>This proposal seeks to onboard USDe to the Aave V4 Core Instance on Avalanche. This proposal follows the Direct to AIP route.</p>\n<h2><a name=\"p-65296-motivation-2\" class=\"anchor\" href=\"#p-65296-motivation-2\" aria-label=\"Heading link\"></a>Motivation</h2>\n<p>USDe is Ethena Labs’ synthetic dollar, targeting a value of one US dollar through a strategy that pairs staked collateral with offsetting perpetual futures positions, held largely offchain. Ethena Labs has extended USDe and its staked form to Avalanche, with support from spot and lending venues across the network.</p>\n<p>Onboarding USDe would:</p>\n<ul>\n<li>Add a synthetic dollar stablecoin to the Aave V4 Core Instance on Avalanche.</li>\n<li>Support demand emerging from Ethena’s expansion of USDe to Avalanche.</li>\n<li>Extend USDe’s collateral footprint within the broader Aave protocol, where it is already listed across other Aave instances.</li>\n</ul>\n<h2><a name=\"p-65296-specification-3\" class=\"anchor\" href=\"#p-65296-specification-3\" aria-label=\"Heading link\"></a>Specification</h2>\n<p>This proposal onboards USDe to the Aave V4 Core Instance on Avalanche.</p>\n<p>Risk parameters and final configuration will be provided by the Risk Service Providers and this proposal will be updated accordingly.</p>\n<h3><a name=\"p-65296-useful-links-4\" class=\"anchor\" href=\"#p-65296-useful-links-4\" aria-label=\"Heading link\"></a>Useful Links</h3>\n<ul>\n<li><a href=\"https://docs.ethena.fi/\">Ethena Documentation</a></li>\n</ul>\n<h2><a name=\"p-65296-disclaimer-5\" class=\"anchor\" href=\"#p-65296-disclaimer-5\" aria-label=\"Heading link\"></a>Disclaimer</h2>\n<p>This proposal was prepared by Aave Labs in its capacity as a contributor to the Aave ecosystem. Aave Labs has no direct financial relationship with Ethena Labs or its affiliates and has not received compensation from Ethena Labs or its affiliates in connection with this proposal.</p>\n<h2><a name=\"p-65296-next-steps-6\" class=\"anchor\" href=\"#p-65296-next-steps-6\" aria-label=\"Heading link\"></a>Next Steps</h2>\n<ol>\n<li>Gather community and Service Provider feedback.</li>\n<li>Incorporate the Risk Service Providers’ final configuration for the Aave V4 Core Instance on Avalanche.</li>\n<li>Publish the AIP vote for final confirmation and onchain enforcement of the proposal.</li>\n</ol>\n<h2><a name=\"p-65296-copyright-7\" class=\"anchor\" href=\"#p-65296-copyright-7\" aria-label=\"Heading link\"></a>Copyright</h2>\n<p>Copyright and related rights waived via <a href=\"https://creativecommons.org/publicdomain/zero/1.0/\">CC0</a>.</p>", "created_at": "2026-09-01T10:12:44.876Z", "current_user_reaction": null, "current_user_used_main_reaction": false, "deleted_at": null, "edit_reason": null, "flair_bg_color": "", "flair_color": "", "flair_group_id": 46, "flair_name": "Aave-Labs-SP", "flair_url": "https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/4/443942b48a86edf3ae83c4bad36dac3eb65b182b.png", "hidden": false, "id": 65296, "incoming_link_count": 12, "link_counts": [{"clicks": 0, "internal": false, "reflection": false, "title": "Ethena Overview | Ethena", "url": "https://docs.ethena.fi/"}, {"clicks": 0, "inter