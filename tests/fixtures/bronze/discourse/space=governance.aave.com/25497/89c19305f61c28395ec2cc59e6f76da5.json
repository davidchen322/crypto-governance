{"actions_summary": [{"can_act": false, "count": 0, "hidden": false, "id": 4}, {"can_act": false, "count": 0, "hidden": false, "id": 8}, {"can_act": false, "count": 0, "hidden": false, "id": 10}, {"can_act": false, "count": 0, "hidden": false, "id": 7}], "archetype": "regular", "archived": false, "bookmarked": false, "bookmarks": [], "can_create_shared_issue": false, "can_vote": false, "category_id": 4, "chunk_size": 20, "closed": false, "created_at": "2026-08-18T12:32:27.029Z", "current_post_number": 1, "deleted_at": null, "deleted_by": null, "details": {"can_edit": false, "created_by": {"avatar_template": "/user_avatar/governance.aave.com/aavelabs/{size}/6388_2.png", "id": 5301, "username": "AaveLabs"}, "last_poster": {"avatar_template": "/user_avatar/governance.aave.com/llamarisk/{size}/12865_2.png", "id": 10100, "username": "LlamaRisk"}, "links": [{"attachment": false, "clicks": 2, "domain": "docs.pendle.finance", "internal": false, "reflection": false, "root_domain": "pendle.finance", "title": "PT | Pendle Documentation", "url": "https://docs.pendle.finance/pendle-v2/ProtocolMechanics/YieldTokenization/PT", "user_id": 5301}], "notification_level": 1, "participants": [{"admin": true, "avatar_template": "/user_avatar/governance.aave.com/aavelabs/{size}/6388_2.png", "flair_bg_color": "", "flair_color": "", "flair_group_id": 46, "flair_name": "Aave-Labs-SP", "flair_url": "https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/4/443942b48a86edf3ae83c4bad36dac3eb65b182b.png", "id": 5301, "moderator": true, "post_count": 1, "primary_group_name": "Aave-Labs-SP", "trust_level": 4, "username": "AaveLabs"}, {"avatar_template": "/user_avatar/governance.aave.com/llamarisk/{size}/12865_2.png", "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "flair_name": null, "flair_url": null, "id": 10100, "moderator": true, "post_count": 1, "primary_group_name": null, "trust_level": 2, "username": "LlamaRisk"}]}, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "draft": null, "draft_key": "topic_25497", "draft_sequence": null, "fancy_title": "[Direct to AIP] Onboard PT-sUSDe-26NOV2026 to Aave V4 Plus Hub", "featured_link": null, "has_accepted_answer": false, "has_cached_summary": false, "has_livestream": null, "has_summary": false, "highest_post_number": 2, "id": 25497, "image_url": null, "last_posted_at": "2026-08-31T14:58:11.274Z", "like_count": 0, "message_bus_last_id": 6, "participant_count": 2, "pinned": false, "pinned_at": null, "pinned_globally": false, "pinned_until": null, "post_stream": {"posts": [{"accepted_answer": false, "actions_summary": [], "admin": true, "avatar_template": "/user_avatar/governance.aave.com/aavelabs/{size}/6388_2.png", "badges_granted": [], "bookmarked": false, "calendar_details": [], "can_accept_answer": false, "can_delete": false, "can_edit": false, "can_recover": false, "can_see_hidden_post": false, "can_unaccept_answer": false, "can_view_edit_history": false, "can_vote": false, "can_wiki": false, "cooked": "<p>Title: [Direct to AIP] Onboard PT-sUSDe-26NOV2026 to Aave V4 Plus Hub<br>\nAuthor: <a class=\"mention\" href=\"/u/aavelabs\">@AaveLabs</a><br>\nDate: 2026-08-18</p>\n<hr>\n<h2><a name=\"p-65155-summary-1\" class=\"anchor\" href=\"#p-65155-summary-1\" aria-label=\"Heading link\"></a>Summary</h2>\n<p>This proposal seeks to onboard PT-sUSDe-26NOV2026 to the Aave V4 Plus Hub. This proposal will be Direct-to-AIP.</p>\n<h2><a name=\"p-65155-motivation-2\" class=\"anchor\" href=\"#p-65155-motivation-2\" aria-label=\"Heading link\"></a>Motivation</h2>\n<p>Given the established adoption of PT-sUSDe collateral on the Aave V3 Plasma Instance, this proposal extends that support to the Aave V4 Plus Hub.</p>\n<h2><a name=\"p-65155-specification-3\" class=\"anchor\" href=\"#p-65155-specification-3\" aria-label=\"Heading link\"></a>Specification</h2>\n<p><strong>PT-sUSDe-26NOV2026</strong></p>\n<p>Maturity: 2026-11-26 00:00 UTC</p>\n<h3><a name=\"p-65155-risk-parameters-4\" class=\"anchor\" href=\"#p-65155-risk-parameters-4\" aria-label=\"Heading link\"></a>Risk Parameters</h3>\n<p>Risk parameters will be provided by Risk Service Providers and the proposal will be updated accordingly.</p>\n<h3><a name=\"p-65155-useful-links-5\" class=\"anchor\" href=\"#p-65155-useful-links-5\" aria-label=\"Heading link\"></a>Useful Links</h3>\n<ul>\n<li><a href=\"https://docs.pendle.finance/pendle-v2/ProtocolMechanics/YieldTokenization/PT\">Pendle PT documentation</a></li>\n<li><a href=\"https://docs.ethena.fi/technical-design/staking-usde\">Ethena sUSDe documentation</a></li>\n</ul>\n<h2><a name=\"p-65155-disclaimer-6\" class=\"anchor\" href=\"#p-65155-disclaimer-6\" aria-label=\"Heading link\"></a>Disclaimer</h2>\n<p>This proposal was prepared by Aave Labs in its capacity as a contributor to the Aave ecosystem. Aave Labs has no financial relationship with Pendle Finance or Ethena Labs and has not received compensation from either party in connection with this proposal.</p>\n<h2><a name=\"p-65155-next-steps-7\" class=\"anchor\" href=\"#p-65155-next-steps-7\" aria-label=\"Heading link\"></a>Next Steps</h2>\n<ol>\n<li>DAO Service Providers to post Asset Risk Assessment and Asset Technical Assessment.</li>\n<li>Publish an AIP vote for final confirmation and on-chain enforcement of the proposal.</li>\n</ol>\n<h2><a name=\"p-65155-copyright-8\" class=\"anchor\" href=\"#p-65155-copyright-8\" aria-label=\"Heading link\"></a>Copyright</h2>\n<p>Copyright and related rights waived via <a href=\"https://creativecommons.org/publicdomain/zero/1.0/\">CC0</a>.</p>", "created_at": "2026-08-18T12:32:27.104Z", "current_user_reaction": null, "current_user_used_main_reaction": false, "deleted_at": null, "edit_reason": null, "flair_bg_color": "", "flair_color": "", "flair_group_id": 46, "flair_name": "Aave-Labs-SP", "flair_url": "https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/4/443942b48a86edf3ae83c4bad36dac3eb65b182b.png", "hidden": false, "id": 65155, "incoming_link_count": 9, "link_counts": [{"clicks": 2, "internal": false, "reflection": false, "title": "PT | Pendle Documentation", "url": "https://docs.pendle.finance/pendle-v2/ProtocolMechanics/YieldTokenization/PT"}, {"clicks": 0, "internal": false, "reflection": false, "title": "Staking USDe | Ethena", "url": "https://docs.ethena.fi/technical-design/staking-usde"}, {"clicks": 0, "internal": false, "reflection": false, "title": "Deed - CC0 1.0 Universal - Creative Commons", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}], "moderator": true, "post_number": 1, "post_type": 1, "post_url": "/t/direct-to-aip-onboard-pt-susde-26nov2026-to-aave-v4-plus-hub/25497/1", "posts_count": 2, "primary_group_name": "Aave-Labs-SP", "quote_count": 0, "reaction_users_count": 0, "reactions": [], "read": true, "readers_count": 17, "reads": 18, "reply_count": 0, "reply_to_post_number": null, "score": 48.6, "staff": true, "title_is_group": true, "topic_accepted_answer": null, "topic_id": 25497, "topic_slug": "direct-to-aip-onboard-pt-susde-26nov2026-to-aave-v4-plus-hub", "trust_level": 4, "updated_at": "2026-08-18T12:32:27.104Z", "user_deleted": false, "user_id": 5301, "user_title": "Aave Labs-Technical SP", "username": "AaveLabs", "version": 1, "wiki": false, "yours": false}, {"accepted_answer": false, "actions_summary": [], "admin": false, "avatar_template": "/user_avatar/governance.aave.com/llamarisk/{size}/12865_2.png", "badges_granted": [], "bookmarked": false, "can_accept_answer": false, "can_delete": false, "can_edit": false, "can_recover": false, "can_see_hidden_post": false, "can_unaccept_answer": false, "can_view_edit_history": false, "can_wiki": false, "cooked": "<h2><a name=\"p-65284-summary-1\" class=\"anchor\" href=\"#p-65284-summary-1\" aria-label=\"Heading link\"></a>Summary</h2>\n<p>LlamaRisk supports listing PT-sUSDE-26NOV2026 on the Aave V4 Plus Hub via the Ethena Correlated and Ethena Ecosystem spokes. At the time of this analysis, the asset has 93 days remaining until maturity.</p>\n<p>The November maturity Pendle pool was deployed on August 10, 2026 and holds $3.40M in liquidity at the time of writing. 4.85M PT-sUSDE-26NOV2026 are outstanding, and the asset is not currently listed on any Aave instance.</p>\n<p><strong>Assessment of PT base asset:</strong> <a href=\"https://www.llamarisk.com/research/asset-risk-usde\">Link</a></p>\n<p><strong>Assessment of Pendle PTs:</strong> <a href=\"https://governance.aave.com/t/arfc-onboard-pendle-pt-tokens-to-aave-v3-core-instance/20541\">Link</a></p>\n<p><strong>Considered PT asset maturities:</strong> PT-sUSDE-26NOV2026</p>\n<h2><a name=\"p-65284-asset-state-2\" class=\"anchor\" href=\"#p-65284-asset-state-2\" aria-label=\"Heading link\"></a>Asset State</h2>\n<h3><a name=\"p-65284-asset-growth-3\" class=\"anchor\" href=\"#p-65284-asset-growth-3\" aria-label=\"Heading link\"></a>Asset Growth</h3>\n<p>sUSDe has 1.07B tokens outstanding as of August 25, 2026, backed by 1.33B USDe of vault assets. The share of USDe staked in sUSDe is 32.79%, down 15.10% over the past month.</p>\n<p>Supply has contracted over the period. sUSDe fell from 3.60B in late November 2025, with the steepest leg in late April and early May 2026. SY-sUSDe, the wrapper through which sUSDe enters the Pendle system, stands at 9.39M against an April 2026 peak of 382M, only taking into account Etherum Mainnet.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/4/4b34c61052ff2c8abc6c979b3a4fadbf9e64b742.png\" data-download-href=\"/uploads/short-url/aJiSoFAonJAKkTalLBfMfBPe0Xo.png?dl=1\" title=\"chart0\"><img src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/4/4b34c61052ff2c8abc6c979b3a4fadbf9e64b742_2_2000x860.png\" alt=\"chart0\" data-base62-sha1=\"aJiSoFAonJAKkTalLBfMfBPe0Xo\" width=\"2000\" height=\"860\" srcset=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/4/4b34c61052ff2c8abc6c979b3a4fadbf9e64b742_2_2000x860.png, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/4/4b34c61052ff2c8abc6c979b3a4fadbf9e64b742.png 1.5x, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/4/4b34c61052ff2c8abc6c979b3a4fadbf9e64b742.png 2x\" data-dominant-color=\"0F1217\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">chart0</span><span class=\"informations\">2340×1007 187 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div> <em>Source: LlamaRisk, August 25, 2026</em></p>\n<p>USDe circulating supply stands at $4.07B, consolidated from its October 2025 peak of $14.9B. Protocol solvency stands at 100.27% against a reserve fund of $62.09M.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/6/66268e8d9e0f478892b8d0cd594e8bb701dd785f.png\" data-download-href=\"/uploads/short-url/ezFjciRYuyiOpQsKpUzD35b6Y5p.png?dl=1\" title=\"chart1\"><img src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/6/66268e8d9e0f478892b8d0cd594e8bb701dd785f_2_2000x942.png\" alt=\"chart1\" data-base62-sha1=\"ezFjciRYuyiOpQsKpUzD35b6Y5p\" width=\"2000\" height=\"942\" srcset=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/6/66268e8d9e0f478892b8d0cd594e8bb701dd785f_2_2000x942.png, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/6/66268e8d9e0f478892b8d0cd594e8bb701dd785f.png 1.5x, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/6/66268e8d9e0f478892b8d0cd594e8bb701dd785f.png 2x\" data-dominant-color=\"1A1A1B\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">chart1</span><span class=\"informations\">2520×1188 189 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div> <em>Source:</em> <a href=\"https://dashboard.llamarisk.com/protocols/ethena/overview\"><em>LlamaRisk Risk Portal</em></a><em>, August 25, 2026</em></p>\n<h3><a name=\"p-65284-underlying-stability-4\" class=\"anchor\" href=\"#p-65284-underlying-stability-4\" aria-label=\"Heading link\"></a>Underlying Stability</h3>\n<p>USDe trades at $0.9998 and has held within plus 0.03% to minus 0.22% of par across the past nine months, following the October 2025 depeg episode when it briefly traded near $0.97.</p>\n<p>sUSDe trades at $1.2446 against an internal exchange rate of 1.2449 USDe per token, which accrues with distributed yield. Measured against that rate, its secondary market deviation ranges from plus 0.09% to minus 0.21%, with a median of minus 0.02%. Redemption pays out in USDe subject to Ethena’s unstaking cooldown, currently set to 1 day. No structural anomalies appear in the price series.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/c/c5e5a50ee0946acd6b9a922f0ccdeb6a537bd03a.png\" data-download-href=\"/uploads/short-url/seG4xMn3DHmJpm6S37vieSzNl22.png?dl=1\" title=\"chart2\"><img src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/c/c5e5a50ee0946acd6b9a922f0ccdeb6a537bd03a.png\" alt=\"chart2\" data-base62-sha1=\"seG4xMn3DHmJpm6S37vieSzNl22\" width=\"2000\" height=\"1292\" data-dominant-color=\"121316\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">chart2</span><span class=\"informations\">2340×1512 382 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div> <em>Source: LlamaRisk, August 25, 2026</em></p>\n<h3><a name=\"p-65284-underlying-yield-source-5\" class=\"anchor\" href=\"#p-65284-underlying-yield-source-5\" aria-label=\"Heading link\"></a>Underlying Yield Source</h3>\n<p>sUSDe yield comes from Ethena’s delta-neutral strategy, combining perpetual funding spreads on BTC and ETH with staking yield on the liquid staking derivative component of the collateral and lending on money markets. For PT-sUSDE-26NOV2026, that yield is captured as a discount to par on the principal token, which redeems at maturity for the quantity of sUSDe worth 1 USDe, while the floating component is stripped out to YT-sUSDE-26NOV2026.</p>\n<p>Pendle reports the underlying sUSDe APY at 4.25%.</p>\n<h2><a name=\"p-65284-market-analysis-6\" class=\"anchor\" href=\"#p-65284-market-analysis-6\" aria-label=\"Heading link\"></a>Market Analysis</h2>\n<h3><a name=\"p-65284-total-supply-7\" class=\"anchor\" href=\"#p-65284-total-supply-7\" aria-label=\"Heading link\"></a>Total Supply</h3>\n<p>The PT-sUSDE-26NOV2026 pool was deployed on August 10, 2026 and holds $3.40M in total liquidity, composed of 2,123,439 SY-sUSDe and 770,470 PT-sUSDE-26NOV2026. SY-sUSDe outstanding stands at 9.39M.</p>\n<p>4.85M PT-sUSDE-26NOV2026 have been minted in aggregate, of which 16% sits inside the Pendle AMM and 84% is held off-pool, which is consistent with holders carrying the position to maturity rather than trading it. Pool liquidity has risen from $1.25M on August 14 alongside PT outstanding, with both series flattening over the most recent days.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/6/607aa4be887348ccf8b8dd356a23b9aadd099b68.png\" data-download-href=\"/uploads/short-url/dLuBbjSHJtHI4PBH4ilEPQ2VUVy.png?dl=1\" title=\"chart3\"><img src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/6/607aa4be887348ccf8b8dd356a23b9aadd099b68_2_2000x800.png\" alt=\"chart3\" data-base62-sha1=\"dLuBbjSHJtHI4PBH4ilEPQ2VUVy\" width=\"2000\" height=\"800\" srcset=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/6/607aa4be887348ccf8b8dd356a23b9aadd099b68_2_2000x800.png, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/6/607aa4be887348ccf8b8dd356a23b9aadd099b68.png 1.5x, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/6/607aa4be887348ccf8b8dd356a23b9aadd099b68.png 2x\" data-dominant-color=\"132B2D\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">chart3</span><span class=\"informations\">2340×936 120 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div> <em>Source: LlamaRisk, August 25, 2026</em></p>\n<h3><a name=\"p-65284-pool-composition-8\" class=\"anchor\" href=\"#p-65284-pool-composition-8\" aria-label=\"Heading link\"></a>Pool Composition</h3>\n<p><strong>PT-sUSDE-26NOV2026 Pool:</strong></p>\n<ul>\n<li><strong>Total Liquidity:</strong> $3.40M</li>\n<li><strong>SY-sUSDe:</strong> 2,123,439</li>\n<li><strong>PT-sUSDE-26NOV2026:</strong> 770,470</li>\n</ul>\n<p>The pool is SY-heavy at 73.4% SY and 26.6% PT, which is typical for a Pendle pool in its first weeks.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/f/fa252625bb7284041a49173beb7b393792891190.png\" data-download-href=\"/uploads/short-url/zGSXspZZHayvTvcq21kKwsC3Www.png?dl=1\" title=\"chart4\"><img src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/f/fa252625bb7284041a49173beb7b393792891190_2_2000x428.png\" alt=\"chart4\" data-base62-sha1=\"zGSXspZZHayvTvcq21kKwsC3Www\" width=\"2000\" height=\"428\" srcset=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/f/fa252625bb7284041a49173beb7b393792891190_2_2000x428.png, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/f/fa252625bb7284041a49173beb7b393792891190.png 1.5x, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/f/fa252625bb7284041a49173beb7b393792891190.png 2x\" data-dominant-color=\"1E4C56\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">chart4</span><span class=\"informations\">2520×540 46.4 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div> <em>Source: LlamaRisk, August 25, 2026</em></p>\n<h3><a name=\"p-65284-price-and-yield-9\" class=\"anchor\" href=\"#p-65284-price-and-yield-9\" aria-label=\"Heading link\"></a>Price and Yield</h3>\n<p>The PT implied yield stands at 4.72%, the underlying sUSDe APY at 4.25%, and the PT discount-to-par at 1.16%. The 47 bps spread is the market premium for locking in a fixed rate over the remaining 93 days.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/8/86c4a6fd185ac0558f89bfe82d6940a3724bf41b.png\" data-download-href=\"/uploads/short-url/jedj0KW8FSSlf1PrWkXWCqXu9gn.png?dl=1\" title=\"chart5\"><img src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/8/86c4a6fd185ac0558f89bfe82d6940a3724bf41b_2_2000x800.png\" alt=\"chart5\" data-base62-sha1=\"jedj0KW8FSSlf1PrWkXWCqXu9gn\" width=\"2000\" height=\"800\" srcset=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/8/86c4a6fd185ac0558f89bfe82d6940a3724bf41b_2_2000x800.png, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/8/86c4a6fd185ac0558f89bfe82d6940a3724bf41b.png 1.5x, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/8/86c4a6fd185ac0558f89bfe82d6940a3724bf41b.png 2x\" data-dominant-color=\"0F1217\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">chart5</span><span class=\"informations\">2340×936 132 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div> <em>Source: LlamaRisk, August 25, 2026</em></p>\n<h3><a name=\"p-65284-pt-yield-in-context-10\" class=\"anchor\" href=\"#p-65284-pt-yield-in-context-10\" aria-label=\"Heading link\"></a>PT Yield in Context</h3>\n<p>Against the PT fixed yield of 4.72%, Aave V3 Ethereum mainnet variable borrow rates stand at 2.80% for USDe and 4.62% for USDT, giving positive carry of 192 bps and 10 bps, while USDC at 4.78% and USDS at 5.68% give negative carry of 6 bps and 96 bps. Leveraged PT positions are currently profitable against USDe and USDT borrow, and are not profitable against USDC or USDS.</p>\n<h3><a name=\"p-65284-price-and-implied-apy-projection-11\" class=\"anchor\" href=\"#p-65284-price-and-implied-apy-projection-11\" aria-label=\"Heading link\"></a>Price and Implied APY Projection</h3>\n<p>The chart projects the PT price trajectory and implied APY from the snapshot through maturity, with the AMM’s structural bounds shown as dashed lines. The current implied yield of 4.72% sits against a structural maximum of 12.234% at the AMM’s upper proportion bound.</p>\n<p><div class=\"lightbox-wrapper\"><a class=\"lightbox\" href=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/0/0f01e011cd319cc341fa01b0e59416ccea661092.png\" data-download-href=\"/uploads/short-url/28Lb9bcASRogp4Je4KoEvCKCU4a.png?dl=1\" title=\"chart6\"><img src=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/0/0f01e011cd319cc341fa01b0e59416ccea661092_2_2000x1169.png\" alt=\"chart6\" data-base62-sha1=\"28Lb9bcASRogp4Je4KoEvCKCU4a\" width=\"2000\" height=\"1169\" srcset=\"https://europe1.discourse-cdn.com/flex013/uploads/aave/optimized/2X/0/0f01e011cd319cc341fa01b0e59416ccea661092_2_2000x1169.png, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/0/0f01e011cd319cc341fa01b0e59416ccea661092.png 1.5x, https://europe1.discourse-cdn.com/flex013/uploads/aave/original/2X/0/0f01e011cd319cc341fa01b0e59416ccea661092.png 2x\" data-dominant-color=\"101216\"><div class=\"meta\"><svg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"><use href=\"#far-image\"></use></svg><span class=\"filename\">chart6</span><span class=\"informations\">2340×1368 167 KB</span><svg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"><use href=\"#discourse-expand\"></use></svg></div></a></div> <em>Source: LlamaRisk, August 25, 2026</em></p>\n<h3><a name=\"p-65284-maturities-12\" class=\"anchor\" href=\"#p-65284-maturities-12\" aria-label=\"Heading link\"></a>Maturities</h3>\n<p>PT-sUSDE-26NOV2026 is the only active sUSDe maturity on Pendle. Subsequent maturities listed by Pendle would provide rollover destinations as the November pool approaches its own expiry.</p>\n<h2><a name=\"p-65284-recommendations-13\" class=\"anchor\" href=\"#p-65284-recommendations-13\" aria-label=\"Heading link\"></a>Recommendations</h2>\n<h3><a name=\"p-65284-parameter-recommendation-14\" class=\"anchor\" href=\"#p-65284-parameter-recommendation-14\" aria-label=\"Heading link\"></a>Parameter Recommendation</h3>\n<p>The listing adds PT-sUSDE-26NOV2026 as a collateral reserve on Ethena Ecosystem Spoke of the Plus Hub.</p>\n<p><strong>Collateral reserves: Ethena Ecosystem spoke</strong></p>\n<div class=\"md-table\">\n<table>\n<thead>\n<tr>\n<th>Parameter</th>\n<th>PT-sUSDE-26NOV2026</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Suppliable</td>\n<td>yes</td>\n</tr>\n<tr>\n<td>Collateral</td>\n<td>yes</td>\n</tr>\n<tr>\n<td>Borrowable</td>\n<td>no</td>\n</tr>\n<tr>\n<td>Collateral Factor</td>\n<td>92%</td>\n</tr>\n<tr>\n<td>Max Liquidation Bonus</td>\n<td>4.5%</td>\n</tr>\n<tr>\n<td>Liquidation Fee</td>\n<td>10%</td>\n</tr>\n<tr>\n<td>Collateral Risk score</td>\n<td>0%</td>\n</tr>\n<tr>\n<td>Add Cap</td>\n<td>8,000,000</td>\n</tr>\n</tbody>\n</table>\n</div><p>The borrowable set is unchanged: USDC, USDT, USDe, GHO and frxUSD.</p>\n<p>Pool liquidity has scaled with PT supply since the pool was deployed and is expected to continue to do so, so the Add Cap is set to accommodate growth rather than the current float of 4.85M PT. Available borrowable capacity stands at $2.94M on Ethena Ecosystem and $5.9k on Ethena Correlated, excluding inter-Hub credit lines.</p>\n<h3><a name=\"p-65284-price-feed-recommendation-15\" class=\"anchor\" href=\"#p-65284-price-feed-recommendation-15\" aria-label=\"Heading link\"></a>Price Feed Recommendation</h3>\n<p>For pricing PT-sUSDE-26NOV2026 on the Aave V4 Plus Hub, the <a href=\"https://governance.aave.com/t/arfc-onboard-pendle-pt-tokens-to-aave-v3-core-instance/20541/5\">dynamic linear discount rate oracle</a> is recommended, consistent with the approach used for prior sUSDe maturities on Aave.</p>\n<p>The oracle prices the PT as a zero-coupon bond against a capped Chainlink reference for the underlying, applying a linear discount that decays to par at maturity and is bounded above by a maximum discount rate parameter.</p>\n<h4><a name=\"p-65284-discount-rate-parameters-16\" class=\"anchor\" href=\"#p-65284-discount-rate-parameters-16\" aria-label=\"Heading link\"></a>Discount Rate Parameters</h4>\n<div class=\"md-table\">\n<table>\n<thead>\n<tr>\n<th>Parameter</th>\n<th>PT-sUSDE-26NOV2026</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>initialDiscountRatePerYear</td>\n<td>4.72%</td>\n</tr>\n<tr>\n<td>maxDiscountRatePerYear</td>\n<td>12.23%</td>\n</tr>\n</tbody>\n</table>\n</div><h3><a name=\"p-65284-disclaimer-17\" class=\"anchor\" href=\"#p-65284-disclaimer-17\" aria-label=\"Heading link\"></a>Disclaimer</h3>\n<p>This review was independently prepared by LlamaRisk, a DeFi risk service provider funded in part by the Aave DAO. LlamaRisk serves as a member of Ethena’s Risk Committee and an independent attestor of Ethena’s PoR solution. LlamaRisk did not receive compensation from the protocol(s) or their affiliated entities for this work. The information should not be construed as legal, financial, tax, or professional advice.</p>", "created_at": "2026-08-31T14:58:11.274Z", "current_user_reaction": null, "current_user_used_main_reaction": false, "deleted_at": null, "edit_reason": null, "flair_bg_color": null, "flair_color": null, "flair_group_id": null, "flair_name": null, "flair_url": null, "hidden": false, "id": 65284, "incoming_link_count": 2, "link_counts": [{"clicks": 0, "internal": true, "reflection": false, "title": "[ARFC] Onboard Pendle PT tokens to Aave V3 Core Instance", "url": "https://governance.aave.com/t/arfc-onboard-pendle-pt-tokens-to-aave-v3-core-instance/20541"}, {"clicks": 0, "internal": false, "reflection": false, "title": "Ethena · LlamaRisk Dashboards", "url": "https://dashboard.llamarisk.com/protocols/ethena/overview"}, {"clicks": 0, "internal": true, "reflection": false, "title": "[ARFC] Onboard Pendle PT tokens to Aave V3 Core Instance", "url": "https://governance.aave.com/t/arfc-onboard-pendle-pt-tokens-to-aave-v3-core-instance/20541/5"}, {"clicks": 0, "internal": false, "reflection": false, "url": "https://www.llamarisk.com/research/asset-risk-usde"}], "moderator": true, "post_number": 2, "post_type": 1, "post_url": "/t/direct-to-aip-onboard-pt-susde-26nov2026-to-aave-v4-plus-hub/25497/2", "posts_count": 2, "primary_group_name": null, "quote_count": 0, "reaction_users_count": 0, "reactions": [], "read": true, "readers_count": 13, "reads": 14, "reply_count": 0, "reply_to_post_number": null, "score": 7.6, "staff": true, "title_is_group": false, "topic_accepted_answer": null, "topic_id": 25497, "topic_slug": "direct-to-aip-onboard-pt-susde-26nov2026-to-aave-v4-plus-hub", "trust_level": 2, "updated_at": "2026-08-31T14:58:11.274Z", "user_deleted": false, "use